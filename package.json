{
  "name": "qq-agent-plus",
  "version": "0.7.0",
  "private": false,
  "description": "Linux QQ group agent (OneBot v11)：分条发言、贴纸系统、主动发言与内置运维命令。",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "server": "node src/server.js",
    "ops": "node src/ops.js",
    "test": "node --test test/*.test.mjs && node test/test-prompt.mjs && node test/render-test.mjs && node test/scroll-test.mjs && node test/usage-e2e.mjs",
    "test:unit": "node --test test/*.test.mjs",
    "test:local": "node test/local/run.mjs",
    "test:prompt": "node test/test-prompt.mjs",
    "test:render": "node test/render-test.mjs",
    "test:scroll": "node test/scroll-test.mjs",
    "test:usage": "node test/usage-e2e.mjs",
    "test:legacy-selftest": "node test/selftest.mjs"
  },
  "dependencies": {
    "jce": "0.2.3",
    "node-html-parser": "^9.0.4",
    "undici": "^6.28.0",
    "ws": "^8.18.0"
  },
  "license": "MIT",
  "author": "sakurawwwxh",
  "keywords": [
    "qq",
    "bot",
    "agent",
    "openai",
    "onebot",
    "llm",
    "linux",
    "systemd"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sakurawwwxh/qq-agent-plus.git"
  },
  "bugs": {
    "url": "https://github.com/sakurawwwxh/qq-agent-plus/issues"
  },
  "homepage": "https://github.com/sakurawwwxh/qq-agent-plus#readme"
}
